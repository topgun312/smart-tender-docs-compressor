# .env.example (коммитим в git — без реальных значений!)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# Для Ollama (локально)
OLLAMA_BASE_URL=http://localhost:11434

# Выбор провайдера по умолчанию (локально — Ollama)
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.2

# Лимиты
MAX_TOKENS=2048
REQUEST_TIMEOUT=60

# OCR для сканов (нужен установленный tesseract)
OCR_ENABLED=true
OCR_LANG=rus+eng
OCR_DPI=200
OCR_MIN_AVG_CHARS=100